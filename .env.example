# Local webcam: 0, 1, ... | IP camera: rtsp://user:pass@host:554/stream | video file: path.mp4
CAMERA_SOURCE=0

# Plate detector (torch/ultralytics): "cpu" or "cuda:0" if you have a CUDA-capable GPU
DEVICE=cpu
# PaddleOCR device -- kept CPU-only by default even with DEVICE=cuda:0 above.
# paddlepaddle-gpu installs its own `nvidia.*` CUDA libraries that collide with
# torch's (confirmed: it breaks torch's CUDA import), so running both frameworks
# on GPU in the same venv isn't safe without more careful version pinning.
OCR_DEVICE=cpu

# How long (ms) a stalled RTSP connect/read can block before it's treated as
# failed and reconnected -- protects against a flaky network/NVR hanging forever
CAMERA_OPEN_TIMEOUT_MS=8000
CAMERA_READ_TIMEOUT_MS=8000
CAMERA_RECONNECT_DELAY_SECONDS=2.0

# Detector model size: n (fastest) / s / m / l / x (most accurate)
DETECTOR_MODEL_SIZE=n
DETECTOR_CONF_THRESHOLD=0.4

# PaddleOCR recognition language
OCR_LANG=th

# Run detection+OCR every Nth captured frame (higher = smoother video, slower to notice a plate)
PROCESS_EVERY_N_FRAMES=3
# How long (s) a plate can go undetected before its track is dropped (it left frame)
TRACK_TTL_SECONDS=5.0
TRACK_REOCR_SECONDS=3.0

# Reads below this confidence are discarded (noise / false-positive detections)
MIN_LOG_CONFIDENCE=0.5
# Individual OCR text segments (e.g. a garbled province line) below this are
# dropped before the rest are joined, instead of dragging down the whole read
OCR_MIN_SEGMENT_CONFIDENCE=0.5
# Plate crop is upscaled to this height (px) before OCR for better small-text accuracy
OCR_UPSCALE_HEIGHT=200

MODELS_DIR=models
CAPTURES_DIR=captures
DB_PATH=data/alpr.db
JPEG_QUALITY=80
# Detection/OCR always use the full-resolution frame; the displayed video is
# downscaled to this width before encoding, since a wide-FOV CCTV frame is
# much bigger than a dashboard needs and full-size encode/transfer/decode is
# real, avoidable choppiness. Lower this if the video still feels heavy.
STREAM_MAX_WIDTH=1280

JSON_DIR=json
JSON_EXPORT_INTERVAL_SECONDS=20

# The ESP32 gate-relay board (see firmware/gate_relay/) is reached over a USB
# serial tether, not WiFi -- checked only by app_live/, not app/. Left blank,
# matches still show on the dashboard but no signal is sent. Typical values:
# /dev/ttyUSB0 (Linux), COM3 (Windows).
GATE_SERIAL_PORT=
GATE_SERIAL_BAUD=115200
GATE_SERIAL_TIMEOUT_SECONDS=2.0
# Whitelist of plates allowed to trigger the gate -- its own database, kept
# separate from DB_PATH (app/'s detection log) since it's a manually-curated
# list, not detection history. Manage it at /admin on app_live/.
REGISTERED_PLATES_DB_PATH=data/registered_plates.db
