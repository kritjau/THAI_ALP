# Local webcam: 0, 1, ... | IP camera: rtsp://user:pass@host:554/stream | video file: path.mp4
CAMERA_SOURCE=0

# "cpu" or "cuda:0" if you have a CUDA-capable GPU + matching torch build
DEVICE=cpu

# Detector model size: n (fastest) / s / m / l / x (most accurate)
DETECTOR_MODEL_SIZE=n
DETECTOR_CONF_THRESHOLD=0.4

# EasyOCR languages, comma separated
OCR_LANGS=th,en

# Run detection+OCR every Nth captured frame (higher = smoother video, slower to notice a plate)
PROCESS_EVERY_N_FRAMES=3
TRACK_IOU_THRESHOLD=0.3
TRACK_TTL_SECONDS=5.0
TRACK_REOCR_SECONDS=3.0

MODELS_DIR=models
CAPTURES_DIR=captures
DB_PATH=data/alpr.db
JPEG_QUALITY=80
