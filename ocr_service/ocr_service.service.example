# Template for a systemd --user service running ocr_service/ on GPU, in its
# own venv (never app/'s -- see ocr_service/requirements.txt). Copy to
# ~/.config/systemd/user/ocr_service.service, fix the paths and
# CUDA_VISIBLE_DEVICES below, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now ocr_service.service
#
# Point the main app at it via OCR_SERVICE_URL=http://127.0.0.1:8003 in its
# .env (see .env.example), then restart app/app_live as usual.

[Unit]
Description=ALPR OCR service (GPU, isolated from the main app's venv)
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/THAI_ALP
# Pick a GPU the plate/vehicle detector (DEVICE=cuda:N in the main app's
# .env) isn't already using -- `nvidia-smi` shows what's free.
Environment=CUDA_VISIBLE_DEVICES=1
ExecStart=/path/to/ocr-gpu-venv/bin/uvicorn ocr_service.main:app --host 127.0.0.1 --port 8003
Restart=always
RestartSec=5
MemoryHigh=6G
MemoryMax=8G
# Observed in production: this process's RSS grows with sustained traffic
# (a per-input-shape cache growing in PaddleOCR's inference backend is the
# suspected cause -- see PlateReader._upscale()'s width-rounding comment in
# app/ocr.py) and reached 5.8GB after ~6h uptime, at which point the
# kernel's *global* OOM killer stepped in -- not just this unit's own
# MemoryMax above, because by then the whole machine was out of headroom.
# A clean, planned restart well before that point is far less disruptive
# than an OOM kill: RemoteOCRReader (app/ocr.py) already treats a
# momentarily-unreachable OCR service as just an empty read, not a crash,
# so a 2-hourly restart costs a few seconds of degraded reads, not an
# outage -- versus the swap-thrashing/camera-hang runup an uncontrolled
# OOM event causes on the rest of the system beforehand.
RuntimeMaxSec=2h

[Install]
WantedBy=default.target
